mod iter_tests {
    use super::*;
    use crate::endian::LittleEndian;

    #[rustfmt::skip]
    const GNU_VERNEED_STRINGS: [u8; 65] = [
        // ZLIB_1.2.0 (0x1)
        0x00, 0x5a, 0x4c, 0x49, 0x42, 0x5f, 0x31, 0x2e, 0x32, 0x2e, 0x30, 0x00,
