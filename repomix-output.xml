#[cfg(test)]
mod interface_tests {
    use super::*;
    use crate::abi::{SHT_GNU_HASH, SHT_NOBITS, SHT_NOTE, SHT_NULL, SHT_REL, SHT_RELA, SHT_STRTAB};
    use crate::dynamic::Dyn;
