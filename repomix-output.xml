pub fn p_flags_to_string(p_flags: u32) -> String {
    match p_flags < 8 {
        true => {
            let r = if p_flags & abi::PF_R != 0 { "R" } else { " " };
            let w = if p_flags & abi::PF_W != 0 { "W" } else { " " };
            let x = if p_flags & abi::PF_X != 0 { "E" } else { " " };
            format!("{r}{w}{x}")
        }
        false => format!("p_flags({p_flags:#x})"),
    }
}

