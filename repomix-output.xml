        abi::ELFOSABI_TRU64 => Some("ELFOSABI_TRU64"),
        abi::ELFOSABI_MODESTO => Some("ELFOSABI_MODESTO"),
        abi::ELFOSABI_OPENBSD => Some("ELFOSABI_OPENBSD"),
