#!/bin/bash

cd arceos/ || exit

rm pflash.img -f 
rm disk.img -f

make pflash_img
make disk_img


make run A=exercises/print_with_color/ | tee a.txt

context=$(tail -n 20 ./a.txt )

has_color=false
has_text=false


