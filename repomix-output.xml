        0x47, 0x4c, 0x49, 0x42, 0x43, 0x5f, 0x32, 0x2e, 0x33, 0x00,
    ];

    #[rustfmt::skip]
    const GNU_VERNEED_DATA: [u8; 96] = [
    // {vn_version, vn_cnt,     vn_file,                vn_aux,                 vn_next               }
        0x01, 0x00, 0x01, 0x00, 0x23, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00,
