//!
//! [ArceOS]: https://github.com/arceos-org/arceos
//! [platforms]: https://github.com/arceos-org/arceos/tree/main/platforms

#![no_std]

#[rustfmt::skip]
mod config {
    include!(concat!(env!("OUT_DIR"), "/config.rs"));
}

pub use config::*;

